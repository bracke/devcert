with "config/check_devcert_config.gpr";
project Check_Devcert is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Devcert_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_devcert.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Devcert_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM100");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Check_Devcert;
