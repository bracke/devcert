with "config/devcert_tests_config.gpr";
with "aunit";
with "../devcert.gpr";

project Devcert_Tests is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Devcert_Tests_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("devcert_tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Devcert_Tests_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatwa", "-gnatw_a", "-gnatwe", "-gnatyM100");
   end Compiler;
   --  Bytes out as bytes in; see the note in devcert.gpr.
   package Binder is
      for Default_Switches ("Ada") use ("-Wb");
   end Binder;

end Devcert_Tests;
