with "config/devcert_config.gpr";
with "../cryptolib/cryptolib.gpr";
with "../truststores/truststores.gpr";
with "../i18n/i18n.gpr";
with "../messages/messages.gpr";
with "../terminal_styles/terminal_styles.gpr";

project Devcert is
   for Source_Dirs use ("src", "app", "config");
   for Object_Dir use "obj/" & Devcert_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("main.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Devcert_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatyM100");
   end Compiler;

   package Builder is
      for Executable ("main.adb") use "devcert";
   end Builder;
   --  The run-time wide-character encoding, which decides what Text_IO does
   --  with a byte above 127. Alire's generated switches include -gnatW8, and
   --  the binder takes the same method from it: every such byte is then encoded
   --  to UTF-8 on the way out, so text that was already UTF-8 -- a translated
   --  message, a path with an accent, an internationalized domain name -- came
   --  out doubled. This program treats String as bytes and prints them as it
   --  received them, which is what -Wb (the compiler default) means here.
   package Binder is
      for Default_Switches ("Ada") use ("-Wb");
   end Binder;

   --  Ship share/ (the message catalog and the bundled i18n locale data) so a
   --  deployed devcert renders localized output.
   package Install is
      for Artifacts (".") use ("share");
   end Install;
end Devcert;
