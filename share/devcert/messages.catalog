default_locale = en
en.app.name = "devcert"
en.cli.usage = "usage: devcert [global-options] <command> [command-options] [arguments]"
en.cli.commands = "commands: help, version, install, uninstall, caroot, cert, inspect, doctor"
en.cli.global_options = "global options: --help --version --json --plain --color=auto|always|never"
en.cli.global_options_paths = "                --locale LOCALE --catalog FILE --ca-root DIRECTORY"
en.error.devcert = "devcert: {value}"
en.error.missing_value = "missing value for {value}"
en.error.duplicate_option = "duplicate option {value}"
en.error.invalid_color = "invalid value for --color"
en.error.unknown_option = "unknown option {value}"
en.error.unknown_command = "unknown command"
en.error.profile_order = "profile option must precede identities"
en.error.invalid_certificate_request = "invalid certificate request"
en.error.unsupported_certificate_profile = "unsupported certificate profile: {value}"
en.error.crypto_api_unavailable = "cryptolib certificate API is not available"
en.error.ca_unusable = "CA is not usable: {value}"
en.error.invalid_identity = "invalid certificate identity: {value}"
en.error.mixed_identity_modes = "mixed server and email identities are not supported"
en.error.too_many_identities = "too many certificate identities"
en.error.csr_combination = "--csr cannot be combined with identities or PKCS#12"
en.error.csr_missing = "CSR file is missing: {value}"
en.error.duplicate_p12_password = "duplicate PKCS#12 password option"
en.error.unknown_cert_option = "unknown cert option {value}"
en.error.unknown_trust_store = "unknown trust store: {value}"
en.error.unknown_trust_option = "unknown trust option {value}"
en.cert.signed_csr = "certificate signed from CSR"
en.cert.issued = "certificate issued for {value}"
en.cert.p12_written = "PKCS#12 bundle written to {value}"
en.inspect.ca = "ca={value}"
en.inspect.ca_missing = "ca=missing path={value}"
en.doctor.ca_complete = "doctor: ca complete"
en.doctor.ca_state = "doctor: ca {value}"
en.json.schema = "1"
en.release.passed = "release-check passed"
